  "error_handling": {
    "gmail_401": {
      "error": "Unauthorized",
      "cause": "Token expired or invalid",
      "solution": "Refresh OAuth token"
    },
    "imap_timeout": {
      "error": "Connection timeout",
      "cause": "Network or server issue",
      "solution": "Check host, port, firewall"
    },
    "mcp_connection_failed": {
      "error": "Cannot connect to MCP server",
      "cause": "Server not running or unreachable",
      "solution": "Verify MCP is running: npm start:http"
    },
    "invalid_credentials": {
      "error": "Authentication failed",
      "cause": "Wrong password or username",
      "solution": "Verify credentials, use app passwords"
    }
  },

